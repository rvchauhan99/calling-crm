MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=calling_crm
JWT_SECRET=replace-with-a-long-random-string
COMPANY_ID=default
FRONTEND_URL=http://localhost:3003
ADMIN_EMAIL=admin@baazex.com
ADMIN_PASSWORD=Admin@123
DEMO_PASSWORD=demo@123
COOKIE_SECURE=false
# Set to 1 to disable background Google Sheet polling (tests / local)
SHEET_SYNC_DISABLED=0

# Cloud telephony (mock | plivo_livekit) — see docs/cloud-telephony-build-plan.md
# Softphone / Call UI stays OFF while TELEPHONY_PROVIDER=mock (until Udyam/Plivo + keys).
# Enable UI: TELEPHONY_PROVIDER=plivo_livekit + LIVEKIT_URL + LIVEKIT_API_KEY + LIVEKIT_API_SECRET
# Local UI QA with mock only: TELEPHONY_UI_FORCE=1
TELEPHONY_PROVIDER=mock
TELEPHONY_UI_FORCE=0
TELEPHONY_WEBHOOK_SECRET=
TELEPHONY_MAX_CONCURRENT=5
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_HOST=
LIVEKIT_OUTBOUND_TRUNK_ID=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_DID_E164=
PLIVO_ANSWER_URL=
