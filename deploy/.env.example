# Calling CRM — Vultr API env (frontend on Vercel)
# 1) ./scripts/setup-env.sh   OR   cp .env.example .env
# 2) Fill every REPLACE_ME value
# 3) Never commit .env

# --- MongoDB Atlas ---
# Format: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# URL-encode special characters in the password.
MONGO_URL=mongodb+srv://shrikrishnagovind99_db_user:68Gp1qNNtzJk0wr1@krishnavasudevyadav.geszqem.mongodb.net
DB_NAME=calling_crm

# --- Security ---
# Generate: openssl rand -hex 32
JWT_SECRET=qwertyuiopasdfghjklzxcvbnm1234567890
COMPANY_ID=default
# true when API is served over HTTPS (Caddy / TLS); false for plain http://IP:8000 smoke tests
COOKIE_SECURE=true

# --- Seeded admin (created on first API boot) ---
ADMIN_EMAIL=admin@baazee.com
ADMIN_PASSWORD=admin@123

# --- Demo users password (supervisor / agents / affiliate) ---
DEMO_PASSWORD=demo@123

# --- CORS: your Vercel frontend origin (no trailing slash) ---
# Example: https://calling-crm.vercel.app  or  https://crm.yourdomain.com
FRONTEND_URL=https://REPLACE_ME_VERCEL_OR_CUSTOM_DOMAIN

# Host publish for the API container (no TLS profile)
# Default exposes http://VPS_IP:8000
API_PUBLISH=8000:8000

# --- Optional TLS for the API hostname (docker compose --profile tls) ---
# DNS A record → Vultr VPS IP. Then set API_PUBLISH=127.0.0.1:8000:8000 so Caddy owns 80/443.
DOMAIN=api.REPLACE_ME_YOUR_DOMAIN
